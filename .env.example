# PySysTools - Environment Configuration

# Database Configuration (Mock Example)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=admin_user
DB_PASSWORD=mock_secure_password_here
DB_NAME=sysadmin_db

# Network Scanning Configuration
# Set the default subnet for local testing
DEFAULT_SUBNET=192.168.1.0/24

# External APIs
# VIRUSTOTAL_API_KEY=your_mock_api_key_here

# Security
# Set to 'development' to disable strict real-world protections during testing
APP_ENV=development
